# The Auth0 domain (without the https:// scheme), e.g. your-tenant.auth0.com
AUTH0_DOMAIN={DOMAIN}
# The identifier of your API in the Auth0 dashboard
AUTH0_AUDIENCE={API_IDENTIFIER}

# The legacy ISSUER_BASE_URL and AUDIENCE variables are still supported for
# backwards compatibility. To migrate to the new names, rename:
#   ISSUER_BASE_URL=https://{DOMAIN}  ->  AUTH0_DOMAIN={DOMAIN}     (drop the https://)
#   AUDIENCE={API_IDENTIFIER}         ->  AUTH0_AUDIENCE={API_IDENTIFIER}
